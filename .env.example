# Copy this file to .env and fill only the values you use.
# Never commit .env or paste credentials into source files.

# oSPARC
OSPARC_API_KEY=
OSPARC_API_SECRET=

# Optional AI assistant
OPENAI_API_KEY=

# Dataset downloads
DOWNLOAD_EMAIL=

# Cloud VM management
TENSORDOCK_API_TOKEN=
TENSORDOCK_VM_PASSWORD=

# Sim4Life license configuration
SIM4LIFE_LICENSE_SERVER=

# Bootstrap-only settings used by cloud_setup/setup.bat.
# When bootstrapping a new VM, place a copy of .env beside setup.bat.
GOLIAT_GDRIVE_FOLDER_ID=
GOLIAT_GDRIVE_INSTALLER_FILE_ID=
GOLIAT_VPN_USERNAME=
GOLIAT_VPN_PASSWORD=
GOLIAT_GITHUB_USERNAME=
GOLIAT_GIT_EMAIL=
GOLIAT_GIT_NAME=
