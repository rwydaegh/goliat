{
    "extends": "base_config.json",
    "study_type": "far_field",
    "auto_induced": {
        "enabled": false,
        "top_n": 10,
        "cube_size_mm": 50,
        "search_metric": "E_magnitude",
        "save_intermediate_files": false,
        "use_xy_diagonal_for_sim_time": true,
        "search": {
            "mode": "air",
            "n_samples": 10000,
            "random_seed": 42,
            "shell_size_mm": 10.0,
            "selection_percentile": 95.0,
            "min_candidate_distance_mm": 50.0
        }
    },
    "execution_control": {
        "do_setup": true,
        "only_write_input_file": false,
        "do_run": true,
        "do_extract": true,
        "batch_run": false,
        "auto_cleanup_previous_results": [
            "output"
        ]
    },
    "phantoms": [
        "duke"
    ],
    "frequencies_mhz": [
        450
    ],
    "far_field_setup": {
        "type": "environmental",
        "environmental": {
            "incident_directions": [
                "x_pos"
            ],
            "polarizations": [
                "theta"
            ]
        }
    },
    "simulation_parameters": {
        "bbox_padding_mm": 0,
        "simulation_bbox_points": 8,
        "number_of_point_sensors": 0
    },
    "gridding_parameters": {
        "global_gridding": {
            "grid_mode": "manual",
            "manual_fallback_max_step_mm": 2.0
        },
        "global_gridding_per_frequency": {
            "450": 2.5,
            "3500": 1.0
        },
        "padding": {
            "padding_mode": "manual",
            "manual_bottom_padding_mm": [
                0,
                0,
                0
            ],
            "manual_top_padding_mm": [
                0,
                0,
                0
            ]
        },
        "phantom_bbox_reduction": {
            "use_symmetry_reduction": false,
            "auto_reduce_bbox": false,
            "height_limit_per_frequency_mm": {}
        }
    }
}
